# Example env for TrustMarket Mobile
#
# iOS Simulator: localhost works
# Android Emulator: use http://10.0.2.2:8080/api
#
# If you run via nginx (infra) instead, set:
# - http://localhost:8080/api  (iOS/Web)
# - http://10.0.2.2:8080/api  (Android emulator)
API_BASE_URL=http://localhost:8080/api

# Enable Dio logging in debug/dev
LOG_NETWORK=true
